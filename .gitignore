# Root .gitignore for monorepo

# Dependencies
node_modules/
.pnp
.pnp.js

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!frontend/.env.example
!backend/.env.example
!ai-service/.env.example

# Build outputs
dist/
dist-ssr/
build/
*.egg-info/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / IDE
.DS_Store
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# TypeScript build info
*.tsbuildinfo

# Editor swap files
*.swp
*.swo

# OS (Windows)
Thumbs.db

# Temp files
.tmp/
temp/

# Backend uploads (multer temp files)
uploads/
.vercel
.env*
