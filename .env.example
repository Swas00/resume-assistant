# =============================================================
# Antigravity Manager Surface - Consolidated Environment Config
# =============================================================

# -------------------------------------------------------------
# Database (MongoDB)
# -------------------------------------------------------------
MONGO_PORT=27017
MONGO_INITDB_DATABASE=antigravity_db
MONGO_URI=mongodb://mongodb:27017/antigravity_db

# -------------------------------------------------------------
# Backend Service (Express + TypeScript)
# -------------------------------------------------------------
BACKEND_PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_please_change_in_production_98765
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# -------------------------------------------------------------
# AI Service (FastAPI + LangChain)
# -------------------------------------------------------------
AI_SERVICE_PORT=8000
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_DEFAULT_MODEL=gpt-4o
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# -------------------------------------------------------------
# Frontend Service (React 19 + Vite)
# -------------------------------------------------------------
FRONTEND_PORT=5173
VITE_BACKEND_URL=http://localhost:5000
VITE_AI_SERVICE_URL=http://localhost:8000
VITE_API_BASE_PATH=/api/v1
